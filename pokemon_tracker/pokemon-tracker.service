[Unit]
Description=Pokemon Card Price Tracker
After=network.target graphical.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pokemon_tracker
ExecStart=/usr/bin/python3 /home/pi/pokemon_tracker/main.py
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0

[Install]
WantedBy=graphical.target
