# Credenciales CardMarket API
# Regístrate en https://www.cardmarket.com/en/Pokemon/Account/API
CARDMARKET_APP_TOKEN=your_app_token_here
CARDMARKET_APP_SECRET=your_app_secret_here
CARDMARKET_ACCESS_TOKEN=your_access_token_here
CARDMARKET_ACCESS_SECRET=your_access_secret_here

# Usar sandbox de CardMarket para pruebas (true/false)
CARDMARKET_SANDBOX=false

# Servidor web
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_SECRET_KEY=pokemon-tracker-change-me

# Intervalo de actualización automática de precios (en horas)
UPDATE_INTERVAL_HOURS=24
